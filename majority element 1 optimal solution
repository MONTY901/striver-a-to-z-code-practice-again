class Solution {
    public int majorityElement(int[] v) {
    
    int n = v.length;

    int count = 0;

    int ele = 0;

    for(int i = 0; i < n ; i ++){
        if(count==0){
            ele = v[i];

            count++;
        }
        else if(v[i]==ele){
            count++;
        }
        else{
            count--;
        }
    }

    int counter1= 0;

    for(int i = 0; i < n ; i ++){
        if(v[i]==ele){
            counter1++;

        }
    }

    int split = n/2;

    int majority = 0;

    if(counter1 > n/2){
        majority = ele;
    }

      return majority; 
        
    }
    
}
