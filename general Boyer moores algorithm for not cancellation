class Solution {
    public int majorityElement(int[] v) {

        int count = 0;
        int ele = 0;

        for(int i = 0; i < v.length; i++) {

            if(count == 0) {
                ele = v[i];
            }

            if(v[i] == ele) {
                count++;
            }
            else {
                count--;
            }
        }

        return ele;
    }
}
