class Solution {
    public int[] searchRange(int[] nums, int target) {

        int left = 0;
        int right = nums.length - 1;

        int first = -1;
        int last = -1;

        while (left <= right) {

            int mid = left + (right - left) / 2;

            if (nums[mid] < target) {
                left = mid + 1;
            }
            else if (nums[mid] > target) {
                right = mid - 1;
            }
            else {
                // Target found
                first = mid;
                last = mid;

                // Search for first occurrence
                int l = left;
                int r = mid - 1;

                while (l <= r) {
                    int m = l + (r - l) / 2;

                    if (nums[m] == target) {
                        first = m;
                        r = m - 1;
                    }
                    else {
                        l = m + 1;
                    }
                }

                // Search for last occurrence
                l = mid + 1;
                r = right;

                while (l <= r) {
                    int m = l + (r - l) / 2;

                    if (nums[m] == target) {
                        last = m;
                        l = m + 1;
                    }
                    else {
                        r = m - 1;
                    }
                }

                break;
            }
        }

        return new int[]{first, last};
    }
}
